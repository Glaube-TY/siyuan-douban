{
  "name": "siyuan-douban",
  "version": "4.3.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "description": "Search books from Douban, generate reading notes, and sync WeRead highlights, thoughts, book reviews, and reading statistics to SiYuan (https://github.com/Glaube-TY/siyuan-douban)",
  "repository": "https://github.com/Glaube-TY/siyuan-douban",
  "homepage": "https://glaube-ty.top/sites/siyuan-reading-notes/index.html",
  "author": "Glaube-TY",
  "license": "MIT",
  "scripts": {
    "check:i18n": "node --no-warnings ./scripts/check_i18n.js",
    "check:manifest": "node --no-warnings ./scripts/check_plugin_manifest.js",
    "check": "run-s check:i18n check:manifest",
    "predev": "npm run check",
    "dev": "run-p dev:app dev:kernel",
    "dev:app": "cross-env NODE_ENV=development VITE_BUILD_TARGET=app vite build --watch",
    "dev:kernel": "cross-env NODE_ENV=development VITE_BUILD_TARGET=kernel vite build --watch",
    "dev:debug": "run-p dev:debug:app dev:debug:kernel",
    "dev:debug:app": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=app vite build --watch",
    "dev:debug:kernel": "cross-env NODE_ENV=development VITE_SOURCEMAP=inline VITE_BUILD_TARGET=kernel vite build --watch",
    "dev:setup": "cross-env SIYUAN_SKIP_DEV_DEPLOY=1 pnpm build:dev && node --no-warnings ./scripts/make_dev_link.js",
    "prebuild": "npm run check",
    "build": "run-s build:app build:kernel sync-dev",
    "prebuild:dev": "npm run check",
    "build:dev": "run-s build:dev:app build:dev:kernel",
    "build:dev:app": "cross-env NODE_ENV=development VITE_BUILD_TARGET=app vite build",
    "build:dev:kernel": "cross-env NODE_ENV=development VITE_BUILD_TARGET=kernel vite build",
    "build:app": "cross-env NODE_ENV=production VITE_BUILD_TARGET=app vite build",
    "build:kernel": "cross-env NODE_ENV=production VITE_BUILD_TARGET=kernel vite build",
    "sync-dev": "node --no-warnings ./scripts/sync_dist_to_dev.js",
    "make-link": "pnpm dev:setup",
    "make-link-win": "pnpm dev:setup",
    "update-version": "node --no-warnings ./scripts/update_version.js",
    "release": "node --no-warnings ./scripts/release.js",
    "premake-install": "npm run check",
    "make-install": "pnpm build && node --no-warnings ./scripts/make_install.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "^20.3.0",
    "cross-env": "^7.0.3",
    "fast-glob": "^3.2.12",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "npm-run-all": "4.1.5",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.2.5",
    "svelte": "^4.2.19",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vite": "^5.2.9",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5"
  },
  "dependencies": {
    "echarts": "^5.6.0"
  }
}
